{
  "name": "planner",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.2.4",
  "scripts": {
    "dev": "vite dev",
    "dev:convex": "npx convex dev",
    "dev:worker": "bun run build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run",
    "cf:types": "wrangler types --env-file .env.types",
    "cf:types:check": "wrangler types --env-file .env.types --check",
    "cf:tail": "wrangler tail",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@fontsource-variable/outfit": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.5.0",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.51.0",
    "svelte-check": "^4.4.2",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^7.3.1",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@convex-dev/workos-authkit": "^0.2.2",
    "@dnd-kit/dom": "^0.3.2",
    "@dnd-kit/helpers": "^0.3.2",
    "@dnd-kit/svelte": "^0.3.2",
    "@fontsource/poppins": "^5.2.7",
    "@workos-inc/node": "^8.12.0",
    "bits-ui": "^2.16.3",
    "convex": "^1.34.0",
    "convex-svelte": "^0.0.12",
    "lucide-svelte": "^0.577.0",
    "rough-notation": "^0.5.1",
    "roughjs": "^4.6.6"
  }
}
